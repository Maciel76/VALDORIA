# Vite: http://localhost:5179
# Produção: http://localhost:4189
VALDORIA_DEV_PORT=5179
PORT=4189
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=reino_valdoria
# Ative ao servir por HTTPS atrás de um proxy.
SESSION_SECURE=false


# Token longo para acessar /admin/r/valdoria. Defina um valor secreto com pelo menos 24 caracteres.
VALDORIA_ADMIN_TOKEN=
# Opcional. Declare um caminho somente se quiser usar arquivo em vez do MongoDB.
# VALDORIA_ECONOMY_FILE=.valdoria/economy.json
